<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nemesis Toolkit report — {{ target }}</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0d1117;
      --panel: #161b22;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --critical: #ff4d4f;
      --high: #ff7b72;
      --medium: #d29922;
      --low: #58a6ff;
      --info: #8b949e;
      --accent: #f778ba;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: linear-gradient(160deg, #0d1117 0%, #111827 100%);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.5;
    }
    .wrap { max-width: 1380px; margin: 0 auto; padding: 32px 22px 64px; }
    header { border-bottom: 1px solid var(--border); padding-bottom: 20px; margin-bottom: 24px; }
    h1 { margin: 0 0 6px; font-size: clamp(1.6rem, 3vw, 2.35rem); }
    h1 span { color: var(--accent); }
    .subtle { color: var(--muted); font-size: .92rem; }
    .notice {
      margin: 18px 0 0; padding: 12px 14px; border: 1px solid #6e2c35; border-radius: 8px;
      background: rgba(248,81,73,.08); color: #ffb3ae; font-size: .9rem;
    }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 24px 0; }
    .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
    .card .label { color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; }
    .card .value { font-size: 1.9rem; font-weight: 700; margin-top: 2px; }
    .card.critical .value { color: var(--critical); }
    .card.high .value { color: var(--high); }
    .card.medium .value { color: var(--medium); }
    .card.low .value { color: var(--low); }
    .card.info .value { color: var(--info); }
    .card.total .value { color: var(--text); }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .panel-head { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between; }
    .panel-head h2 { margin: 0; font-size: 1.05rem; }
    .filters { display: flex; gap: 8px; flex-wrap: wrap; }
    button {
      color: var(--text); background: transparent; border: 1px solid var(--border);
      border-radius: 999px; padding: 5px 11px; font-size: .8rem; cursor: pointer;
    }
    button:hover, button.active { border-color: var(--accent); color: var(--accent); }
    table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    th { text-align: left; color: var(--muted); font-weight: 600; padding: 10px 14px; border-bottom: 1px solid var(--border); background: #12171f; }
    td { padding: 12px 14px; border-bottom: 1px solid #21262d; vertical-align: top; }
    tr:last-child td { border-bottom: 0; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .badge.critical { background: rgba(255,77,79,.18); color: var(--critical); }
    .badge.high { background: rgba(255,123,114,.15); color: var(--high); }
    .badge.medium { background: rgba(210,153,34,.15); color: var(--medium); }
    .badge.low { background: rgba(88,166,255,.14); color: var(--low); }
    .badge.info { background: rgba(139,148,158,.14); color: var(--info); }
    .url { word-break: break-all; color: #79c0ff; }
    .mono { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .82rem; }
    .evidence { color: #c9d1d9; word-break: break-word; }
    .muted { color: var(--muted); }
    details summary { cursor: pointer; color: var(--muted); font-size: .75rem; }
    pre { white-space: pre-wrap; word-break: break-word; background: #0d1117; border: 1px solid var(--border); padding: 10px; border-radius: 6px; max-height: 260px; overflow: auto; }
    .empty { padding: 40px; text-align: center; color: var(--muted); }
    footer { margin-top: 26px; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--border); padding-top: 18px; }
    @media (max-width: 760px) {
      table, thead, tbody, th, td, tr { display: block; }
      thead { display: none; }
      tr { border-bottom: 1px solid var(--border); padding: 8px 0; }
      td { border: 0; padding: 7px 14px; }
      td::before { content: attr(data-label) ": "; color: var(--muted); font-weight: 600; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1><span>Nemesis</span> assessment report</h1>
      <div class="subtle">Target: <strong>{{ target }}</strong> &nbsp;·&nbsp; Generated: {{ generated_at }}</div>
      <div class="notice">
        Authorized security testing only. Findings are automated indicators, not proof of exploitability.
        Validate results manually before remediation decisions.
      </div>
    </header>

    <section class="cards" aria-label="Severity summary">
      <div class="card total"><div class="label">Total</div><div class="value">{{ total }}</div></div>
      {% for level in ['critical', 'high', 'medium', 'low', 'info'] %}
      <div class="card {{ level }}"><div class="label">{{ level }}</div><div class="value">{{ counts[level] }}</div></div>
      {% endfor %}
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Findings</h2>
        <div class="filters" role="group" aria-label="Filter by severity">
          <button class="active" data-filter="all">All</button>
          {% for level in ['critical', 'high', 'medium', 'low', 'info'] %}
          <button data-filter="{{ level }}">{{ level|capitalize }}</button>
          {% endfor %}
        </div>
      </div>
      {% if findings %}
      <table id="findings-table">
        <thead>
          <tr>
            <th>Severity</th>
            <th>Type</th>
            <th>URL / Parameter</th>
            <th>Evidence</th>
            <th>Module / Confidence</th>
          </tr>
        </thead>
        <tbody>
          {% for finding in findings %}
          <tr data-severity="{{ finding.severity }}">
            <td data-label="Severity"><span class="badge {{ finding.severity }}">{{ finding.severity }}</span></td>
            <td data-label="Type" class="mono">{{ finding.type }}</td>
            <td data-label="URL / Parameter">
              {% if finding.url %}<div class="url">{{ finding.url }}</div>{% endif %}
              {% if finding.param %}<div class="muted mono">param: {{ finding.param }}</div>{% endif %}
            </td>
            <td data-label="Evidence">
              <div class="evidence">{{ finding.evidence }}</div>
              {% if finding.metadata %}
              <details>
                <summary>metadata</summary>
                <pre>{{ finding.metadata | tojson(indent=2) }}</pre>
              </details>
              {% endif %}
            </td>
            <td data-label="Module">
              <div class="mono">{{ finding.module }}</div>
              <div class="muted">confidence: {{ finding.confidence }}</div>
              <div class="muted mono">{{ finding.timestamp }}</div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="empty">No findings were produced by this assessment.</div>
      {% endif %}
    </section>

    <footer>
      Generated by <strong>nemesis</strong>. Detection-only: no exploitation, data extraction, or
      lateral movement is performed. Re-test and manually review every result.
    </footer>
  </div>
  <script>
    const buttons = document.querySelectorAll('[data-filter]');
    const rows = document.querySelectorAll('#findings-table tbody tr');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        const filter = button.dataset.filter;
        rows.forEach((row) => {
          row.hidden = filter !== 'all' && row.dataset.severity !== filter;
        });
      });
    });
  </script>
</body>
</html>
